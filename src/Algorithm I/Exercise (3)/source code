#include <stdio.h>

int main() {
    int pg[10], razao, inicial;

    // Exercício 04 - Progressão Geométrica
    printf("Digite o termo inicial e a razão da PG:\n");
    scanf("%d %d", &inicial, &razao);

    pg[0] = inicial;
    printf("PG[0] = %d\n", pg[0]);
    for (int i = 1; i < 10; i++) {
        pg[i] = pg[i - 1] * razao;
        printf("PG[%d] = %d\n", i, pg[i]);
    }

    return 0;
}
