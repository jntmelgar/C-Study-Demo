#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int matriz1[5][5], matriz2[5][5], iguais = 1;

    // Gerar valores aleatórios 0 e 1
    srand(time(NULL));
    printf("Matriz 1:\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            matriz1[i][j] = rand() % 2;
            printf("%d ", matriz1[i][j]);
        }
        printf("\n");
    }

    printf("Matriz 2:\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            matriz2[i][j] = rand() % 2;
            printf("%d ", matriz2[i][j]);
            if (matriz1[i][j] != matriz2[i][j])
                iguais = 0; // Marcar como diferentes
        }
        printf("\n");
    }

    // Verificar igualdade
    if (iguais)
        printf("As matrizes são iguais.\n");
    else
        printf("As matrizes são diferentes.\n");

    return 0;
}
