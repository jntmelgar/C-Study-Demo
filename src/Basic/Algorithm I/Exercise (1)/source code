#include <stdio.h>

int main() {
    int matriz[6][6], count = 0;

    // Entrada de dados
    printf("Digite os valores para preencher a matriz 6x6:\n");
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 6; j++) {
            scanf("%d", &matriz[i][j]);
            if (matriz[i][j] > 10)
                count++;
        }
    }

    // Resultado
    printf("A matriz possui %d valores maiores que 10.\n", count);

    return 0;
}
