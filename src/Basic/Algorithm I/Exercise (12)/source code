#include <stdio.h>

int main() {
    int matriz[6][6], soma = 0, somaDiagonal = 0;

    // Entrada de dados
    printf("Digite os valores para preencher a matriz 6x6:\n");
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 6; j++) {
            scanf("%d", &matriz[i][j]);
            soma += matriz[i][j]; // Soma total
            if (i == j)
                somaDiagonal += matriz[i][j]; // Soma da diagonal principal
        }
    }

    // Resultados
    printf("Soma dos valores da matriz: %d\n", soma);
    printf("Soma da diagonal principal: %d\n", somaDiagonal);

    return 0;
}
